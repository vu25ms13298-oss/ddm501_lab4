{
  "__inputs": [],
  "__requires": [],
  "uid": "ddm501-model",
  "title": "DDM501 — Model Behaviour",
  "description": "ML-specific monitoring: drift, score distribution, decision mix, fairness, and explanation cost.",
  "tags": [
    "ddm501",
    "lab04",
    "model"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Is the model still looking at the same world?",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Drift score (max PSI)",
      "description": "Conventional PSI bands: <0.10 stable, 0.10-0.25 moderate, >=0.25 significant.",
      "gridPos": { "x": 0, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "ml_drift_score",
          "legendFormat": "PSI",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Drift window size",
      "description": "Requests in the monitoring window. Below 200 the statistics are noise.",
      "gridPos": { "x": 5, "y": 1, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "ml_drift_window_size",
          "legendFormat": "window",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 200 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Fairness gap",
      "description": "Largest difference in selection rate between any two groups.",
      "gridPos": { "x": 9, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "ml_fairness_gap",
          "legendFormat": "gap",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Input drift",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "PSI per feature",
      "description": "Population Stability Index for each monitored feature. A feature crossing 0.10 is moderate drift; 0.25 is significant.",
      "gridPos": { "x": 0, "y": 7, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "ml_feature_drift_psi",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Aggregate drift score",
      "description": "Maximum PSI across all monitored features over time.",
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "ml_drift_score",
          "legendFormat": "max PSI",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "What the model is saying",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Score distribution (quantiles)",
      "description": "Quantiles of the predicted default probability over time. A shift here means the model is saying something different about the population.",
      "gridPos": { "x": 0, "y": 17, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ml_prediction_score_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(ml_prediction_score_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ml_prediction_score_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Decision mix",
      "description": "Rate of each underwriting decision. A shift in the DECLINE share is what changes the manual review workload.",
      "gridPos": { "x": 8, "y": 17, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "sum by (decision) (rate(ml_decisions_total[5m]))",
          "legendFormat": "{{decision}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Prediction errors by type",
      "description": "Failures inside the model call, distinct from HTTP 5xx.",
      "gridPos": { "x": 16, "y": 17, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(ml_prediction_errors_total[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Fairness",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Selection rate by group",
      "description": "Share of applicants in each group sent to review or decline. A gap between groups is the fairness signal.",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "ml_selection_rate",
          "legendFormat": "group {{group}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Fairness gap over time",
      "description": "Max minus min selection rate across groups. Aggregate drift and score can both look healthy while this moves.",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "ml_fairness_gap",
          "legendFormat": "gap",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Cost of explaining",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Explanation latency",
      "description": "SHAP is far more expensive than a prediction. Measured separately so a slow /explain cannot hide inside the prediction percentile.",
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ml_explain_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ml_explain_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1.0 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Explanations rate",
      "description": "How many SHAP explanations the service is computing per second.",
      "gridPos": { "x": 12, "y": 35, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
      "targets": [
        {
          "expr": "rate(ml_explanations_total[5m])",
          "legendFormat": "explanations/s",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-ddm501" },
          "instant": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
